      "Bash(head .env:*)",
      "Bash(tail .env:*)",
      "Bash(less .env:*)",
      "Bash(more .env:*)",
      "Bash(nl .env:*)",
      "Bash(tac .env:*)",
      "Bash(bat .env:*)",
      "Bash(strings .env:*)",
      "Bash(xxd .env:*)",
      "Bash(od .env:*)",
      "Bash(hexdump .env:*)",
      "Bash(grep .env:*)",
      "Bash(grep:* .env:*)",
      "Bash(rg .env:*)",
      "Bash(sed .env:*)",
      "Bash(awk .env:*)",
      "Bash(vi .env:*)",
      "Bash(vim .env:*)",
      "Bash(nano .env:*)",
      "Bash(open .env:*)",
      "Bash(cp .env:*)",
