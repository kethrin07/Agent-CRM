# ─────────────────────────────────────────────────────────────
# MyHomeQuote CRM — environment template
#
# Copy this file to `.env.local` and fill in real values there.
# `.env.local` is gitignored and is NOT readable by Claude.
# Only NEXT_PUBLIC_* values are exposed to the browser; everything
# else stays server-side (API routes / server components only).
# ─────────────────────────────────────────────────────────────

# ── ElevenLabs (voice agents + conversations) ──
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_WEBHOOK_SECRET=your-post-call-webhook-signing-secret
ELEVENLABS_AGENT_ID_NORA=agent_id_for_nora
ELEVENLABS_AGENT_ID_BOB=agent_id_for_bob
ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# ── Supabase (leads database) ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ── Twilio (inbound phone numbers) ──
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
